# ----- LLM provider configuration -----
# The text model must support JSON output AND native Chat Completions tools.
# Default: Groq free tier. Get a free key at https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Set to true ONLY on corporate networks that do SSL inspection with a
# self-signed root certificate (otherwise leave false / unset).
DISABLE_SSL_VERIFY=false

# ----- Optional: run the model locally with Ollama (arXiv still needs internet) -----
# 1. Install Ollama (https://ollama.com) and run:  ollama pull llama3.1
# 2. Set the values below and change LLM_PROVIDER to "ollama"
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ----- Optional: DeepSeek -----
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=your_available_model
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ----- PaperScout local file cache -----
# Set via process environment (for example: export PAPERSCOUT_CACHE_DIR=.cache/paperscout).
# PAPERSCOUT_CACHE_DIR=.cache/paperscout
# Optional SQLite checkpoint path, also a process environment variable:
# export PAPERSCOUT_CHECKPOINT_DB=.cache/paperscout/checkpoints.sqlite

# ----- Visual figures, charts and complex tables -----
# deepseek-flash automatically reuses DEEPSEEK_* for image input.
# For another compatible vision service, configure all three explicitly:
# VISION_MODEL=your_vision_model
# VISION_BASE_URL=https://your-compatible-service/v1
# VISION_API_KEY=your_vision_api_key
VISION_ENABLED=true
VISION_MAX_PAGES=3
